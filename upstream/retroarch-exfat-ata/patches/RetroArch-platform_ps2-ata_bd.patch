+   /* A second BDM volume - which is what an internal ATA drive becomes once
+    * ata_bd is loaded - was unreachable: the list only ever offered "mass:",
+    * i.e. volume 0. With a USB stick plugged in, the stick takes volume 0 and
+    * the internal drive lands on volume 1, mounted and readable but never
+    * offered. Hence mass1: here - "mass:" above already IS volume zero, so
+    * listing mass0: as well would only show the same device twice.
+    *
+    * Which name the drive gets depends on the ps2sdk the core was built
+    * against: a current bdmfs_fatfs registers one iomanX device per distinct
+    * bd->path, and ps2atad sets bd->path = "ata", so the drive shows up as
+    * ata0:. An older bdmfs_fatfs folds every block device into "mass" and the
+    * drive is just another massN:. Both are listed, so the same binary works
+    * either way. */
+   menu_entries_append(list,
+         rootDevicePath(BOOT_DEVICE_MASS1),
+         msg_hash_to_str(MENU_ENUM_LABEL_FILE_DETECT_CORE_LIST_PUSH_DIR),
+         enum_idx,
+         FILE_TYPE_DIRECTORY, 0, 0, NULL);
+   menu_entries_append(list,
+         rootDevicePath(BOOT_DEVICE_ATA0),
+         msg_hash_to_str(MENU_ENUM_LABEL_FILE_DETECT_CORE_LIST_PUSH_DIR),
+         enum_idx,
+         FILE_TYPE_DIRECTORY, 0, 0, NULL);
+
